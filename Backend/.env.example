# =====================================================
# Variables de entorno del Backend (MarmaCitas)
# -----------------------------------------------------
# Copia este archivo a `.env` para desarrollo local.
# NO uses credenciales reales aquí; usa valores de
# ejemplo seguros y reemplázalos en tu entorno.
# =====================================================

# Cadena de conexión a MongoDB (base de datos marmacitas).
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/marmacitas?retryWrites=true&w=majority

# Secreto para firmar los JWT. Genera uno largo y aleatorio.
JWT_SECRET=cambia-este-secreto-por-uno-seguro-y-largo

# Puerto del servidor Express (opcional; por defecto 5000).
PORT=5000

# Directorio físico de archivos clínicos (opcional).
# Por defecto: Backend/uploads/appointments
# UPLOADS_DIR=uploads/appointments